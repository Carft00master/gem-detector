# ==============================================================================
# GEM DETECTOR - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to '.env' in the project root:
#     copy .env.example .env     (Windows)
#     cp .env.example .env       (Linux / macOS)
#
# DO NOT commit your real '.env' file to version control.
# .gitignore is configured to strictly ignore '.env' and '.env.*'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Solana Multi-RPC Endpoints (Round-Robin with per-endpoint credit budgeting)
# ------------------------------------------------------------------------------
# Multiple RPC URLs separated by commas.
# Endpoint 0: Helius Developer Tier (1,000,000 credits/mo)
# Endpoint 1: Ankr Freemium Tier (200,000,000 API credits/mo)
# Endpoint 2: dRPC Free Tier (210,000,000 Compute Units/mo)
SOLANA_RPC_URLS="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY,https://rpc.ankr.com/solana/YOUR_ANKR_API_KEY,https://lb.drpc.live/solana/YOUR_DRPC_API_KEY"

# Fallback single RPC URL (used if SOLANA_RPC_URLS is not set)
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# ------------------------------------------------------------------------------
# 2. Solana WebSocket Endpoint
# ------------------------------------------------------------------------------
# Used for real-time account and slot subscriptions
SOLANA_WS_URL="wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# ------------------------------------------------------------------------------
# 3. Yellowstone gRPC Endpoint & Authentication Token
# ------------------------------------------------------------------------------
# High-throughput validator shred streaming (e.g. Shyft, Triton One, or Helius LaserStream)
# Format: host:port (e.g., grpc.solana.example.com:443)
SOLANA_GRPC_ENDPOINT=""
SOLANA_GRPC_TOKEN=""

# ------------------------------------------------------------------------------
# 4. Provider Tier Override
# ------------------------------------------------------------------------------
# Options: "FREE" or "PAID"
# In FREE tier: Live Route B is strictly disabled, Route A is tagged "polled, not streamed"
# If SOLANA_GRPC_ENDPOINT is set and PROVIDER_TIER is not set, it defaults to PAID.
# Keep as FREE if operating within free-tier credit allowances.
PROVIDER_TIER="FREE"
