    {
      "name": "liquidity_quality",
      "formula": "min(1.0, liquidity_mc_ratio / 0.25)",
      "weight": 0.85
    },
    {
      "name": "holder_quality",
      "formula": "max(0.0, 1.0 - (top10_effective_pct / 40.0))",
      "weight": 0.95
    },
    {
      "name": "breakout_quality",
      "formula": "BreakoutStructureClassifier score / 100.0",
      "weight": 0.75
    },
    {
      "name": "wallet_independence",
      "formula": "1.0 - cabal_risk_score",
      "weight": 0.80
